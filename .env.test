# Entorno de pruebas e2e (BD eia_test del docker-compose). Sin secretos reales: se versiona.
NODE_ENV=test
PORT=3999
LOG_LEVEL=silent
APP_PUBLIC_URL=http://localhost:3999
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
DOCS_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=1000
DATABASE_URL=postgresql://eia:eia@127.0.0.1:5434/eia_test?schema=public&connect_timeout=30
DIRECT_URL=
JWT_ACCESS_SECRET=test-only-secret-test-only-secret-0123456789
JWT_ACCESS_TTL=15m
MAIL_DRIVER=console
MAIL_FROM="EIA Test <test@example.com>"
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=eia-test
STORAGE_ACCESS_KEY_ID=eia
STORAGE_SECRET_ACCESS_KEY=eia-secret-key
STORAGE_FORCE_PATH_STYLE=true
# Los jobs se prueban llamando al servicio directamente.
SCHEDULER_ENABLED=false
# Fase 05: datos bancarios FICTICIOS para las e2e de transferencia (no son reales).
BANK_TRANSFER_ACCOUNT_HOLDER=Escuela Itinerante del Agua (prueba)
BANK_TRANSFER_BANK_NAME=Banco de Prueba
BANK_TRANSFER_CLABE=000000000000000000
