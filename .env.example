# =============================================================================
# Escuela Itinerante del Agua — Backend
# Copia este archivo a `.env` (cp .env.example .env). Los valores por defecto funcionan con
# `docker compose up -d`. Esquema y validación: src/config/env.schema.ts
# =============================================================================

# --- App ---------------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# URL pública de esta API (enlaces en correos y "server" en OpenAPI)
APP_PUBLIC_URL=http://localhost:3000
# URL del frontend (enlaces de verificación, recuperación, etc. en los correos)
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma (sin barra final)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Activa /docs (Scalar) y /docs/openapi.json
DOCS_ENABLED=true

# --- Rate limit global (por IP) -----------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- Base de datos (PostgreSQL) -------------------------------------------------
# Conexión que usa la app en tiempo de ejecución. En Supabase: URL del pooler (ver docs/DEPLOY.md).
DATABASE_URL=postgresql://eia:eia@127.0.0.1:5434/eia_dev?schema=public&connect_timeout=30
# Conexión para migraciones (directa o "session pooler"). Opcional: si falta se usa DATABASE_URL.
DIRECT_URL=

# --- Auth (Fase 01) -----------------------------------------------------------
# Secreto del JWT de acceso: mínimo 32 caracteres. Generar: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-0123456789
# Vida del token de acceso (formato ms/jsonwebtoken: 15m, 1h)
JWT_ACCESS_TTL=15m
# Vida del refresh token (días): normal y con "recordarme"
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_REMEMBER_TTL_DAYS=30

# --- Correo -----------------------------------------------------------------------
# console (solo log) | smtp (Mailpit en dev) | resend (producción)
MAIL_DRIVER=smtp
MAIL_FROM="Escuela Itinerante del Agua <no-reply@escuelaitinerante.local>"
# Buzón del equipo para notificaciones internas
MAIL_TEAM_INBOX=equipo@escuelaitinerante.local
# Buzón que recibe los mensajes del formulario de Contacto (HU-38). Vacío = MAIL_TEAM_INBOX
CONTACT_INBOX_EMAIL=contacto@escuelaitinerante.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Obligatoria si MAIL_DRIVER=resend
RESEND_API_KEY=

# --- Anti-spam / privacidad ------------------------------------------------------------
# Cloudflare Turnstile (captcha invisible del formulario de Contacto). Vacío = desactivado
TURNSTILE_SECRET_KEY=
# Secreto para el HMAC de las IPs guardadas. Vacío = se deriva de JWT_ACCESS_SECRET
IP_HASH_SECRET=

# --- Almacenamiento S3 (MinIO en dev; Supabase Storage S3 o Cloudflare R2 en prod) ---------
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=eia-dev
STORAGE_ACCESS_KEY_ID=eia
STORAGE_SECRET_ACCESS_KEY=eia-secret-key
# true para MinIO y Supabase Storage
STORAGE_FORCE_PATH_STYLE=true
# Vigencia de las URLs firmadas (segundos)
STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- Stripe (Fase 05; opcionales por ahora) ------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
