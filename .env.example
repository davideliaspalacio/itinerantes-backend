# =============================================================================
# Escuela Itinerante del Agua — Backend
# Copia este archivo a `.env` (cp .env.example .env). Los valores por defecto funcionan con
# `docker compose up -d`. Esquema y validación: src/config/env.schema.ts
# =============================================================================

# --- App ---------------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# URL pública de esta API (enlaces en correos y "server" en OpenAPI)
APP_PUBLIC_URL=http://localhost:3000
# URL del frontend (enlaces de verificación, recuperación, etc. en los correos)
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma (sin barra final)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Activa /docs (Scalar) y /docs/openapi.json
DOCS_ENABLED=true

# --- Rate limit global (por IP) -----------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- Base de datos (PostgreSQL) -------------------------------------------------
# Conexión que usa la app en tiempo de ejecución. En Supabase: URL del pooler (ver docs/DEPLOY.md).
DATABASE_URL=postgresql://eia:eia@127.0.0.1:5434/eia_dev?schema=public&connect_timeout=30
# Conexión para migraciones (directa o "session pooler"). Opcional: si falta se usa DATABASE_URL.
DIRECT_URL=

# --- Auth (Fase 01) -----------------------------------------------------------
# Secreto del JWT de acceso: mínimo 32 caracteres. Generar: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-0123456789
# Vida del token de acceso (formato ms/jsonwebtoken: 15m, 1h)
JWT_ACCESS_TTL=15m
# Vida del refresh token (días): normal y con "recordarme"
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_REMEMBER_TTL_DAYS=30

# --- Correo -----------------------------------------------------------------------
# console (solo log) | smtp (Mailpit en dev) | resend (producción)
MAIL_DRIVER=smtp
MAIL_FROM="Escuela Itinerante del Agua <no-reply@escuelaitinerante.local>"
# Buzón del equipo para notificaciones internas
MAIL_TEAM_INBOX=equipo@escuelaitinerante.local
# Buzón que recibe los mensajes del formulario de Contacto (HU-38). Vacío = MAIL_TEAM_INBOX
CONTACT_INBOX_EMAIL=contacto@escuelaitinerante.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Obligatoria si MAIL_DRIVER=resend
RESEND_API_KEY=

# --- Anti-spam / privacidad ------------------------------------------------------------
# Cloudflare Turnstile (captcha invisible del formulario de Contacto). Vacío = desactivado
TURNSTILE_SECRET_KEY=
# Secreto para el HMAC de las IPs guardadas. Vacío = se deriva de JWT_ACCESS_SECRET
IP_HASH_SECRET=

# --- Almacenamiento S3 (MinIO en dev; Supabase Storage S3 o Cloudflare R2 en prod) ---------
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=eia-dev
STORAGE_ACCESS_KEY_ID=eia
STORAGE_SECRET_ACCESS_KEY=eia-secret-key
# true para MinIO y Supabase Storage
STORAGE_FORCE_PATH_STYLE=true
# URL base pública de imágenes de difusión (portadas, fotos de docentes): `${BASE}/${key}`.
# Vacía = URLs firmadas de 7 días (ver docs/DEPLOY.md). Ej. Supabase: https://<ref>.supabase.co/storage/v1/object/public/eia-public
STORAGE_PUBLIC_BASE_URL=
# Fase 06: bucket aparte para las imágenes de difusión que sube el panel (keys `public/...`). Vacío =
# todo va a STORAGE_BUCKET (en ese caso deja vacía STORAGE_PUBLIC_BASE_URL). Ver docs/DEPLOY.md.
STORAGE_PUBLIC_BUCKET=

# --- Seed -------------------------------------------------------------------------------
# Siembra las ofertas demo de Fase 02 (diplomado, curso, taller, evento, convocatorias, Moodle).
# Por defecto: true fuera de producción, false en producción. Ver docs/DEPLOY.md.
SEED_DEMO_DATA=
# Vigencia de las URLs firmadas (segundos)
STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- Tareas programadas (Fases 03–04) -----------------------------------------------------
# Jobs en proceso: avisos de "registro de asistencia abierto" y "grupo de WhatsApp disponible"
# (HU-13/HU-18), desde Fase 04 vencimiento de postulaciones aprobadas y recordatorios de saldo y
# de entrevista (HU-13/HU-21) y, desde Fase 05, cobro automático de cuotas, reintentos, mora, aviso
# de cuota próxima y conciliación de checkouts. Con varias réplicas, true solo en una. Por defecto true.
SCHEDULER_ENABLED=true

# --- Stripe (Fase 05) -------------------------------------------------------------------------
# Sin STRIPE_SECRET_KEY la app arranca igual: los checkouts responden 503 PAYMENTS_NOT_CONFIGURED y
# la transferencia sigue funcionando. Configuración y `stripe listen`: docs/DEPLOY.md → "Stripe".
# Llave secreta: sk_test_… (pruebas) / sk_live_… (producción) o restringida rk_…
STRIPE_SECRET_KEY=
# Secreto de firma del endpoint de webhook (whsec_…). Local: lo imprime `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Llave publicable (pk_…). Informativa: Checkout es hospedado y el frontend no la necesita.
STRIPE_PUBLISHABLE_KEY=

# --- Transferencia bancaria México (Fase 05, HU-23) -------------------------------------------
# Datos que ve la persona al pagar su saldo por transferencia. Si falta alguno, la opción no se
# ofrece ("Disponible pronto"). NO pongas datos reales en el repo: configúralos en Railway.
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_BANK_NAME=
# CLABE interbancaria de 18 dígitos
BANK_TRANSFER_CLABE=

# --- Primer SUPER_ADMIN (Fase 06) ----------------------------------------------------------------
# El seed (en cada arranque) crea o promueve esta cuenta SOLO si no existe ningún SUPER_ADMIN activo.
# Vacío = no hace nada. Contraseña: mínimo 12 caracteres con letra y número (solo se usa al CREAR la
# cuenta; si el correo ya existe, no se cambia). Alternativa: `ADMIN_PASSWORD=… pnpm admin:create
# --email …`. En desarrollo ya existe admin@example.com (Admin12345). Ver docs/DEPLOY.md, sección 8.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# --- Reuniones generadas desde el panel (Zoom / Google Meet) ---------------------------------------
# Botón "Generar enlace" de sesiones (HU-29) y entrevistas (HU-31). Cada proveedor se habilita SOLO si
# todas sus variables obligatorias tienen valor (o ninguna: deshabilitado; la app arranca igual y el
# equipo sigue pegando enlaces a mano). Cómo obtenerlas: docs/DEPLOY.md, sección 9. Nunca en el repo.
#
# Zoom: app "Server-to-Server OAuth" (marketplace.zoom.us) con scopes meeting:write:admin y
# meeting:read:admin (o los granulares equivalentes).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Anfitrión de las reuniones (correo o id de un usuario de la cuenta). Vacío = "me" (dueño de la app)
ZOOM_HOST_USER=
#
# Google Meet: cuenta de servicio con delegación de todo el dominio (Google Workspace) y el scope
# https://www.googleapis.com/auth/calendar.events. Los eventos se crean en el calendario del usuario
# suplantado, que será el organizador de la reunión.
GOOGLE_MEET_SERVICE_ACCOUNT_EMAIL=
# Llave privada PEM del JSON de la cuenta de servicio ("private_key"), en una línea con \n literales
# y entre comillas: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_MEET_PRIVATE_KEY=
# Usuario de Workspace suplantado (p. ej. agenda@escuelaitinerante.org)
GOOGLE_MEET_IMPERSONATE_USER=
# Calendario donde se crean los eventos. Vacío = "primary" (el del usuario suplantado)
GOOGLE_MEET_CALENDAR_ID=
